# ==============================================================================
# ROOMMATE EXPENSE TRACKER - ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local development.
# In production (e.g. Vercel Project Settings > Environment Variables), configure
# these exact variables. NEVER commit real credentials to Git.

# 1. DATABASE CONNECTION
# ------------------------------------------------------------------------------
# For Local MySQL:
DATABASE_URL="mysql://root:password@localhost:3306/roommate_expense_tracker"

# For Managed Cloud MySQL (PlanetScale, AWS RDS, Aiven, Railway, etc.):
# Note: Always include SSL query params (e.g., sslaccept=strict) and connection limits
# for serverless environments.
# DATABASE_URL="mysql://<user>:<password>@<managed-cloud-host>:3306/<dbname>?sslaccept=strict&connection_limit=10"

# 2. AUTHENTICATION & SESSION SECRET
# ------------------------------------------------------------------------------
# A cryptographically secure random string (minimum 32 characters) used to sign
# and verify stateless JWT session cookies.
# Generate on Linux/macOS with: openssl rand -base64 32
# Generate on Windows PowerShell with: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 }))
AUTH_SECRET="dev-secret-key-at-least-32-chars-long-roommate-expense-tracker-local"

# 3. CANONICAL APPLICATION URL
# ------------------------------------------------------------------------------
# Used for absolute URL resolution and callback routing.
# In local development:
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# In production on Vercel:
# NEXT_PUBLIC_APP_URL="https://your-roommate-tracker.vercel.app"

# 4. NODE ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV="development"
